# Codex 작업 결과 보고 (지시서만 커밋하고 결과는 남기지 않는다)
docs/codex/*.result.txt

# 로컬 데이터 — 실데이터는 저장소에 절대 올리지 않는다
*.xlsx
*.xlsm
*.xls
!docs/**/*.xlsx

# OS / 편집기
Thumbs.db
desktop.ini
.DS_Store
*.lnk
.vscode/
.idea/

# React/Vite 로컬 산출물
node_modules/
dist/
.npm-cache/

# Codex 로컬 실행 로그 (프롬프트·전사 기록, 저장소에 남기지 않는다)
.codex-runs/

# 배포용 zip 산출물
*.zip

# Vite 로컬 캐시
.vite/

# 구버전 소스 스냅샷. 로컬 보관용이라 저장소에 넣지 않는다
backup/

# 파이썬 컴파일 산출물. 실행할 때마다 바뀌므로 저장소에 두지 않는다
__pycache__/
*.pyc
