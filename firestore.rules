rules_version = '2';

// Fabric R&D 데이터 접근 규칙
// - 가입: 방문자가 자기 계정으로 users/{uid} 문서를 status='pending'으로 생성(가입 신청)
// - 승인: 소유자(OWNER_EMAIL)만 status를 approved/rejected로 변경
// - 데이터 읽기: 소유자 또는 승인된(approved) 사용자
// - 데이터 쓰기: 소유자 또는 승인된 사용자
// 소유자를 바꾸려면 아래 이메일과 src/data/app-config.ts의 OWNER_EMAIL을 함께 수정한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'hkpark@hansoll.com';
    }
    function isApproved() {
      return isOwner()
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwner());
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow update: if isOwner()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isOwner();
    }

    match /state/{docId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /trendStars/{uid} {
      allow read: if isApproved();
      allow create, update: if isApproved() && request.auth.uid == uid;
      allow delete: if isOwner() || (isApproved() && request.auth.uid == uid);
    }

    match /presence/{uid} {
      allow read: if isApproved();
      allow create, update: if isApproved() && request.auth.uid == uid;
      allow delete: if isOwner() || (isApproved() && request.auth.uid == uid);
    }

    // 작업 이력. 덧붙이기 전용이다. 한 번 남긴 기록은 아무도 고치거나 지우지 못한다.
    // 되돌리기의 근거라 사후 편집이 가능하면 의미가 없다.
    match /auditLog/{docId} {
      allow read: if isApproved();
      allow create: if isApproved()
                    && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }

    // 공정 일정 확정 목표(baseline). 개발 건 1건당 문서 1개이고 문서 ID가 고정이다.
    // 한 번 확정하면 아무도 고치거나 지우지 못한다. 재설정 1회 제한이 이 규칙으로 선다.
    // 레코드 안에 두면 행 전체 단위 병합에 덮이므로 권위값을 여기 둔다.
    match /scheduleBaseline/{rowKey} {
      allow read: if isApproved();
      allow create: if isApproved()
                    && request.resource.data.confirmedBy == request.auth.token.email
                    && request.resource.data.rowKey == rowKey;
      allow update, delete: if false;
    }

    // 일정 변경 이력. 덧붙이기 전용이고 보관 기간이 없다.
    // auditLog(90일)보다 오래 남아야 담당자별 납기 준수율을 셀 수 있다.
    match /scheduleLog/{docId} {
      allow read: if isApproved();
      allow create: if isApproved()
                    && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }

    // 원가계산서는 버전이 쌓이는 이력이라 state가 아닌 별도 컬렉션이다.
    // 수정은 허용하되 새 문서는 로그인 이메일을 작성자로 기록한다.
    match /costSheets/{docId} {
      allow read: if isApproved();
      allow create: if isApproved()
                    && request.resource.data.by == request.auth.token.email;
      allow update: if isApproved();
      allow delete: if isOwner();
    }

    // 사내 자료 색인이며 색인 스크립트가 소유자 계정으로 올린다.
    // 팀원 분류 수정 화면이 생기면 update 권한을 넓힌다.
    match /referenceItems/{docId} {
      allow read: if isApproved();
      allow create, update, delete: if isOwner();
    }

    // 바이어 시험 프로토콜은 바이어 기밀 문서다. 2026-10-21에 읽기만 승인 사용자로 열었다(R342).
    // 누가 보는지는 SETTING 권한 표의 BUYER PROTOCOLS 열이 정하고, 화면이 구독 자체를 막는다.
    // 규칙은 그 뒤를 받치는 마지막 방어선이라 쓰기는 소유자로 남긴다. 기준표 개정은 소유자만 한다.
    match /buyerProtocols/{docId} {
      allow read: if isApproved();
      allow write: if isOwner();
    }

    // 바이어 시험 기준 매트릭스(취합본 엑셀 개정본). buyerProtocols와 같은 권한으로 묶는다.
    match /protocolMatrix/{docId} {
      allow read: if isApproved();
      allow write: if isOwner();
    }

    // 원문 매뉴얼에서 뽑은 변경 후보(검토 대기). 승인되면 protocolMatrix 새 버전이 된다.
    match /protocolReview/{docId} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
